LEGO_PATH=/etc/lego
LEGO_SERVER=letsencrypt
LEGO_EMAIL=enter-email
LEGO_ACCEPT_TOS=true
LEGO_DOMAINS=*.lab.emptyvessel-playground.ru
LEGO_DNS=timewebcloud
LEGO_DNS_RESOLVERS=1.1.1.1:53
LEGO_DEPLOY_HOOK=systemctl reload nginx
TIMEWEBCLOUD_AUTH_TOKEN_FILE=/etc/lego/timeweb.token
TIMEWEBCLOUD_PROPAGATION_TIMEOUT=600
