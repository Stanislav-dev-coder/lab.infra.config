[Unit]
Description=Segmentation rules nftables
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/nft-rules
ExecStop=/usr/sbin/nft delete table ip segment

[Install]
WantedBy=sysinit.target
